# Copy to .env and fill in. Never commit .env.

# Postgres superuser for the health database (db container and migrations only).
POSTGRES_PASSWORD=change-me
# Service role logins (`openssl rand -hex 24` each). Applied by the migrate service.
HC_COACH_RO_PASSWORD=change-me
HC_COACH_RW_PASSWORD=change-me
HC_INGEST_PASSWORD=change-me
# Optional read-only login for Grafana; leave empty to keep it disabled.
HC_GRAFANA_DB_PASSWORD=

# IANA time zone that decides which calendar day a record belongs to (local_date).
HC_TIMEZONE=UTC
HC_LOG_LEVEL=INFO

# Daily WHOOP-style scoring settings.
# Profile fallbacks: values the coach stores with set_profile (database) take precedence.
# Maximum heart rate. Fallback when unset: Tanaka 208 - 0.7*age; if age unknown too, 190.
HC_HR_MAX=
# Birth year to estimate age (age = current year - birth_year).
HC_BIRTH_YEAR=
# Biological sex ("male" or "female") for Banister TRIMP coefficients. Unset uses the mean.
HC_SEX=
# Baseline sleep need in minutes (defaults to 480 = 8 hours).
HC_SLEEP_NEED_BASE_MIN=

# Host header values the MCP endpoint accepts (JSON list).
HC_MCP_ALLOWED_HOSTS=["localhost:*","127.0.0.1:*","coach.example.com"]

# Where the host publishes the services. Defaults keep them on loopback.
HC_MCP_PUBLISH=127.0.0.1:8080
HC_DB_PUBLISH=127.0.0.1:5432

# Open Food Facts API base URL
HC_OFF_BASE_URL=https://world.openfoodfacts.org

# ntfy notifications (push alerts and weekly review summaries)
HC_NTFY_URL=https://ntfy.sh
HC_NTFY_TOPIC=
# Access token (tk_...) when your ntfy server requires auth; empty for ntfy.sh topics.
HC_NTFY_TOKEN=
# Notification language: "en" (default) or "cs" (Czech).
HC_NOTIFY_LANG=en

# openGym: base URL as seen from the worker container (e.g. http://opengym:3000),
# and optional catalogue release version tag (defaults to 1.4.1). Pair interactively
# via `health-coach auth opengym` (stored encrypted in oauth_tokens using HC_TOKEN_KEY).
HC_OPENGYM_URL=
HC_OPENGYM_VERSION=1.4.1

# Remote access through an OIDC provider such as Authentik
# (docs/adr/0001-authentik-as-authorization-server.md).
HC_PUBLIC_URL=https://coach.example.com/mcp
HC_AUTH_ISSUER=https://auth.example.com/application/o/health-coach/
HC_AUTH_AUDIENCE=
# JWKS URL of the provider. Defaults to <issuer>/jwks/ (Authentik); set it for other
# providers or to fetch the keys from an internal URL.
HC_AUTH_JWKS_URL=
# The `sub` claim(s) allowed to use the health connector (e.g. usernames, if the provider
# uses them as `sub`).
HC_AUTH_ALLOWED_SUBJECTS=["your-username"]
# Only for a loopback-only development stack:
# HC_AUTH_DISABLED=true

# Fernet key for OAuth tokens at rest:
# python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
HC_TOKEN_KEY=
# Google Health API OAuth client (Google Cloud console). Redirect URI must be registered.
HC_GOOGLE_CLIENT_ID=
HC_GOOGLE_CLIENT_SECRET=
HC_GOOGLE_REDIRECT_URI=http://localhost:8765/callback

# -----------------------------------------------------------------------------
# Healthstats web PWA (docs/web.md)
# -----------------------------------------------------------------------------
HC_WEB_HOST=127.0.0.1
HC_WEB_PORT=8090
HC_WEB_PUBLISH=127.0.0.1:8090
# Allowed usernames behind forward-auth proxy (JSON list, empty = no check for local dev)
HC_WEB_ALLOWED_USERS=["your-username"]
# Header passed by reverse proxy with the authenticated username
HC_WEB_USER_HEADER=X-authentik-username

# -----------------------------------------------------------------------------
# Fit MCP server (multi-user openGym connector, docs/fit.md)
# -----------------------------------------------------------------------------
FIT_OPENGYM_URL=
FIT_OPENGYM_VERSION=1.4.1
FIT_DB_PATH=/data/fit.db
# Fernet key for encrypting user openGym bearer tokens at rest:
# python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
FIT_TOKEN_KEY=
FIT_PUBLIC_URL=https://fit.example.com/mcp
FIT_AUTH_ISSUER=https://auth.example.com/application/o/fit/
FIT_AUTH_AUDIENCE=["fit-client-id"]
FIT_AUTH_JWKS_URL=
# Only for a loopback-only development stack:
# FIT_AUTH_DISABLED=true
FIT_MCP_HOST=127.0.0.1
FIT_MCP_PORT=8081
FIT_MCP_ALLOWED_HOSTS=["localhost:*","127.0.0.1:*","fit.example.com"]
FIT_MCP_PUBLISH=127.0.0.1:8081
FIT_TIMEZONE=UTC
