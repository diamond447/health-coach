      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${ds}"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  w.local_date::timestamptz AS time,\n  w.weekly_rate_kg AS \"Weekly rate\",\n  t.weekly_rate_min_kg AS \"Target min\",\n  t.weekly_rate_max_kg AS \"Target max\"\nFROM v_weight_trend w\nLEFT JOIN LATERAL (\n  SELECT tg.weekly_rate_min_kg, tg.weekly_rate_max_kg\n  FROM targets tg\n  WHERE tg.effective_from <= w.local_date\n  ORDER BY tg.effective_from DESC, tg.id DESC LIMIT 1\n) t ON true\nWHERE w.local_date BETWEEN $__timeFrom()::date AND $__timeTo()::date\n  AND w.weekly_rate_kg IS NOT NULL\nORDER BY w.local_date;",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "masskg",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1
          }
        },
        "overrides": [
