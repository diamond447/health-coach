    {
      "id": 6,
      "title": "Weekly Rate vs Target Band",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 4
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
