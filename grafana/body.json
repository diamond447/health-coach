    {
      "id": 8,
      "title": "TDEE History (Confidence Coloured)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 12
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${ds}"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${ds}"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  local_date::timestamptz AS time,\n  avg_intake AS \"Avg intake\",\n  CASE WHEN confidence = 'high' THEN tdee END AS \"TDEE (high confidence)\",\n  CASE WHEN confidence = 'medium' THEN tdee END AS \"TDEE (medium confidence)\",\n  CASE WHEN confidence IN ('low', 'none') THEN tdee END AS \"TDEE (low/no confidence)\"\nFROM tdee_estimates\nWHERE local_date BETWEEN $__timeFrom()::date AND $__timeTo()::date\nORDER BY local_date;",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "kcal",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "showPoints": "auto",
            "pointSize": 5
