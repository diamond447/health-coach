          "rawSql": "SELECT\n  local_date::timestamptz AS time,\n  weight_kg AS \"Daily weight\",\n  avg_7d_kg AS \"7-day average\",\n  trend_kg AS \"Trend\"\nFROM v_weight_trend\nWHERE local_date BETWEEN $__timeFrom()::date AND $__timeTo()::date\nORDER BY local_date;",
          "refId": "A"
        }
      ],
      "fieldConfig": {
