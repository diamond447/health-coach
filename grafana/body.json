          "rawQuery": true,
          "rawSql": "SELECT\n  count(DISTINCT local_date) AS \"Days logged\"\nFROM nutrition_entries\nWHERE deleted_at IS NULL\n  AND local_date BETWEEN ($__timeTo()::date - 6) AND $__timeTo()::date;",
