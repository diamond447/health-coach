  "panels": [
    {
      "id": 1,
      "title": "Weekly Hard Sets per Muscle Group (Target 10-20)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${ds}"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${ds}"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  week_start::timestamptz AS time,\n  muscle,\n  hard_sets\nFROM v_strength_volume_weekly\nWHERE week_start BETWEEN $__timeFrom()::date AND $__timeTo()::date\nORDER BY week_start;",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "thresholdsStyle": {
              "mode": "line"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              },
              {
                "color": "green",
                "value": 10
              },
              {
                "color": "red",
                "value": 20
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        }
      }
    },
    {
      "id": 2,
      "title": "Estimated 1RM (e1RM) over Time",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${ds}"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${ds}"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  local_date::timestamptz AS time,\n  exercise,\n  e1rm_kg\nFROM v_exercise_e1rm\nWHERE local_date BETWEEN $__timeFrom()::date AND $__timeTo()::date\n  AND exercise IN (${exercise:singlequote})\nORDER BY local_date;",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "masskg",
          "custom": {
            "drawStyle": "line",
            "showPoints": "auto",
            "pointSize": 5,
            "lineWidth": 2
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        }
      }
    },
    {
      "id": 3,
      "title": "Weekly Strength Tonnage",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${ds}"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${ds}"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  date_trunc('week', local_date)::timestamptz AS time,\n  round(sum(tonnage_kg)) AS \"Weekly tonnage\"\nFROM v_daily\nWHERE local_date BETWEEN $__timeFrom()::date AND $__timeTo()::date\n  AND tonnage_kg IS NOT NULL\nGROUP BY 1\nORDER BY 1;",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "masskg",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "lineWidth": 0
          },
          "color": {
            "mode": "fixed",
            "fixedColor": "#5794F2"
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        }
      }
    },
    {
      "id": 4,
      "title": "Other Activities (Minutes by Type)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${ds}"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${ds}"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  local_date::timestamptz AS time,\n  activity_type,\n  sum(duration_min) AS \"Duration (min)\"\nFROM exercise_sessions\nWHERE deleted_at IS NULL\n  AND local_date BETWEEN $__timeFrom()::date AND $__timeTo()::date\nGROUP BY local_date, activity_type\nORDER BY local_date;",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "m",
          "custom": {
            "drawStyle": "bars",
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "fillOpacity": 80,
            "lineWidth": 0
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        }
      }
    }
  ],
