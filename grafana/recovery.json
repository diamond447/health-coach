    {
      "id": 4,
      "title": "Sleep Start Time Consistency",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${ds}"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${ds}"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  local_date::timestamptz AS time,\n  round((EXTRACT(HOUR FROM start_ts AT TIME ZONE current_setting('TimeZone')) +\n         EXTRACT(MINUTE FROM start_ts AT TIME ZONE current_setting('TimeZone')) / 60.0)::numeric, 2) AS \"Bedtime (local hour)\"\nFROM sleep_sessions\nWHERE is_main = true\n  AND local_date BETWEEN $__timeFrom()::date AND $__timeTo()::date\nORDER BY local_date;",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "h",
          "custom": {
            "drawStyle": "points",
            "pointSize": 6,
            "lineWidth": 1,
            "showPoints": "always"
          },
          "color": {
            "mode": "fixed",
            "fixedColor": "#FF780A"
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        }
      }
    },
